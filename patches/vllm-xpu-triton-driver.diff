+        # Dual-GPU host (NVIDIA + Intel): the NVIDIA triton driver reports active
+        # via its own check even though torch.cuda is unavailable. When the XPU
+        # build is selected, keep only the Intel (XPU) driver so Triton stays
+        # enabled for XPU kernel compilation.
+        if (
+            os.environ.get("VLLM_TARGET_DEVICE", "cuda").lower() == "xpu"
+            and len(active_drivers) > 1
+        ):
+            active_drivers = [
+                d for d in active_drivers
+                if "nvidia" not in getattr(d, "__module__", "")
+            ]
+
